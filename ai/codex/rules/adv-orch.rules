# The security-advisory-orchestrator script talks to Solo's local HTTP API and GitHub, both of which the sandbox blocks.
# "allow" only skips the approval prompt: the agent still has to request escalation for it to leave the sandbox.
prefix_rule(
    pattern = [[
        "~/.claude/skills/security-advisory-orchestrator/scripts/adv-orch",
        "/Users/jason/.claude/skills/security-advisory-orchestrator/scripts/adv-orch",
        "~/.agents/skills/security-advisory-orchestrator/scripts/adv-orch",
        "/Users/jason/.agents/skills/security-advisory-orchestrator/scripts/adv-orch",
    ]],
    decision = "allow",
)
