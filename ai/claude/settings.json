{
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/ai/claude/statusline.sh"
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "light",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git -C:*)",
      "Bash(gh pr *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status)",
      "Bash(gh repo view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh auth status)",
      "Bash(gh search *)",
      "Bash(gh api *)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(which:*)",
      "Bash(command:*)",
      "Bash(mkdir:*)",
      "Bash(ln:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(tput:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npm list:*)",
      "Bash(npm outdated)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(brew outdated)",
      "Bash(open *)",
      "Bash(composer:*)",
      "Bash(php:*)",
      "Bash(phpunit *)",
      "Bash(vendor/bin/phpunit *)",
      "mcp__solo__*"
    ],
    "deny": [
      "Bash(*git add -A*)",
      "Bash(git add --all*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
